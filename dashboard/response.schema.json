{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Read-only dashboard API v1 response",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "resource", "meta", "data"],
  "properties": {
    "api_version": {"const": "1"},
    "resource": {"enum": ["overview", "positions", "orders", "events", "performance", "health", "error"]},
    "meta": {"$ref": "#/$defs/meta"},
    "data": {}
  },
  "allOf": [
    {"if": {"properties": {"resource": {"const": "overview"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/overview"}}}},
    {"if": {"properties": {"resource": {"const": "positions"}}}, "then": {"properties": {"data": {"type": "array", "items": {"$ref": "#/$defs/position"}}}}},
    {"if": {"properties": {"resource": {"const": "orders"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/orders"}}}},
    {"if": {"properties": {"resource": {"const": "events"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/events"}}}},
    {"if": {"properties": {"resource": {"const": "performance"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/performance"}}}},
    {"if": {"properties": {"resource": {"const": "health"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/health"}}}},
    {"if": {"properties": {"resource": {"const": "error"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/error"}}}},
    {
      "if": {
        "properties": {"resource": {"const": "overview"}, "data": {"properties": {"entries": {"const": "last_observed_allowed"}}}}
      },
      "then": {"properties": {"meta": {"properties": {"telemetry_run_id": {"$ref": "#/$defs/id"}, "telemetry": {"properties": {"freshness": {"const": "fresh"}}}}}}}
    },
    {
      "if": {
        "properties": {"resource": {"const": "health"}, "data": {"properties": {"runtime": {"enum": ["running", "stopped", "faulted"]}}}}
      },
      "then": {"properties": {"meta": {"properties": {"telemetry_run_id": {"$ref": "#/$defs/id"}, "telemetry": {"properties": {"freshness": {"const": "fresh"}}}}}}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 200},
    "cursor": {"type": "string", "minLength": 1, "maxLength": 2048},
    "utc": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"},
    "optionalUtc": {"anyOf": [{"$ref": "#/$defs/utc"}, {"type": "null"}]},
    "decimal": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "nonnegativeDecimal": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "optionalNonnegative": {"anyOf": [{"$ref": "#/$defs/nonnegativeDecimal"}, {"type": "null"}]},
    "optionalDecimal": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["observed_at", "freshness", "max_age_seconds"],
      "properties": {
        "observed_at": {"$ref": "#/$defs/optionalUtc"},
        "freshness": {"enum": ["fresh", "stale", "missing", "invalid"]},
        "max_age_seconds": {"type": "integer", "minimum": 1}
      },
      "allOf": [
        {"if": {"properties": {"freshness": {"const": "missing"}}}, "then": {"properties": {"observed_at": {"type": "null"}}}},
        {"if": {"properties": {"freshness": {"enum": ["fresh", "stale"]}}}, "then": {"properties": {"observed_at": {"$ref": "#/$defs/utc"}}}}
      ]
    },
    "meta": {
      "type": "object", "additionalProperties": false,
      "required": ["generated_at", "source_mode", "database_id", "environment", "ledger_revision", "telemetry_run_id", "ledger", "telemetry", "broker"],
      "properties": {
        "generated_at": {"$ref": "#/$defs/utc"},
        "source_mode": {"enum": ["demo", "recorded"]},
        "database_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "journal_head": {"type": "integer", "minimum": 0},
        "environment": {"enum": ["paper", "live", "unknown"]},
        "ledger_revision": {"type": ["integer", "null"], "minimum": 1},
        "telemetry_run_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "ledger": {"$ref": "#/$defs/source"},
        "telemetry": {"$ref": "#/$defs/source"},
        "broker": {"$ref": "#/$defs/source"}
      }
    },
    "overview": {
      "type": "object", "additionalProperties": false,
      "required": ["currency", "accounting_day", "recorded_equity", "realized_pnl", "unrealized_pnl", "entries", "block_reasons"],
      "properties": {
        "currency": {"const": "USD"},
        "accounting_day": {"type": ["string", "null"], "format": "date"},
        "recorded_equity": {"$ref": "#/$defs/optionalDecimal"},
        "realized_pnl": {"$ref": "#/$defs/optionalDecimal"},
        "unrealized_pnl": {"$ref": "#/$defs/optionalDecimal"},
        "entries": {"enum": ["last_observed_allowed", "blocked", "unknown"]},
        "block_reasons": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      },
      "allOf": [
        {"if": {"properties": {"entries": {"const": "blocked"}}}, "then": {"properties": {"block_reasons": {"minItems": 1}}}},
        {"if": {"properties": {"entries": {"const": "last_observed_allowed"}}}, "then": {"properties": {"block_reasons": {"maxItems": 0}}}}
      ]
    },
    "position": {
      "type": "object", "additionalProperties": false,
      "required": ["position_id", "symbol", "strategy", "side", "quantity", "entry_price", "hard_stop", "trailing_stop", "broker_stop", "protection", "protection_observed_at", "pending_exit_order_id", "exit_pending"],
      "properties": {
        "position_id": {"$ref": "#/$defs/id"}, "symbol": {"$ref": "#/$defs/id"},
        "strategy": {"$ref": "#/$defs/id"}, "side": {"enum": ["long", "short"]},
        "quantity": {"$ref": "#/$defs/nonnegativeDecimal"},
        "entry_price": {"$ref": "#/$defs/nonnegativeDecimal"},
        "hard_stop": {"$ref": "#/$defs/nonnegativeDecimal"},
        "trailing_stop": {"$ref": "#/$defs/optionalDecimal"},
        "broker_stop": {"$ref": "#/$defs/optionalDecimal"},
        "protection": {"enum": ["last_verified", "unverified", "unknown"]},
        "protection_observed_at": {"$ref": "#/$defs/optionalUtc"},
        "exit_pending": {"type": "boolean"},
        "pending_exit_order_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
      },
      "allOf": [
        {"if": {"properties": {"protection": {"const": "last_verified"}}}, "then": {"properties": {"protection_observed_at": {"$ref": "#/$defs/utc"}, "broker_stop": {"$ref": "#/$defs/nonnegativeDecimal"}}}}
      ]
    },
    "order": {
      "type": "object", "additionalProperties": false,
      "required": ["client_id", "broker_order_id", "position_id", "symbol", "side", "status", "requested_quantity", "cumulative_filled_quantity", "observed_at"],
      "properties": {
        "client_id": {"$ref": "#/$defs/id"},
        "broker_order_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "position_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "symbol": {"$ref": "#/$defs/id"}, "side": {"enum": ["buy", "sell"]},
        "status": {"$ref": "#/$defs/id"},
        "requested_quantity": {"$ref": "#/$defs/optionalNonnegative"},
        "cumulative_filled_quantity": {"$ref": "#/$defs/optionalNonnegative"},
        "observed_at": {"$ref": "#/$defs/optionalUtc"}
      }
    },
    "orders": {
      "type": "object", "additionalProperties": false, "required": ["items", "next_cursor"],
      "properties": {
        "items": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/order"}},
        "next_cursor": {"anyOf": [{"$ref": "#/$defs/cursor"}, {"type": "null"}]}
      }
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "kind", "observed_at", "symbol", "summary"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1}, "kind": {"$ref": "#/$defs/id"},
        "observed_at": {"$ref": "#/$defs/utc"},
        "symbol": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "summary": {"type": "string", "maxLength": 500}
      }
    },
    "events": {
      "type": "object", "additionalProperties": false, "required": ["items", "next_after", "has_more"],
      "properties": {
        "items": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/event"}},
        "next_after": {"type": "integer", "minimum": 0}, "has_more": {"type": "boolean"},
        "next_cursor": {"anyOf": [{"$ref": "#/$defs/cursor"}, {"type": "null"}]}
      }
    },
    "exit": {
      "type": "object", "additionalProperties": false,
      "required": ["execution_id", "position_id", "symbol", "quantity", "fill_at", "accounting_day", "exit_price", "price_verified", "gross_pnl", "fees", "fees_estimated", "net_pnl"],
      "properties": {
        "execution_id": {"$ref": "#/$defs/id"}, "position_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "symbol": {"$ref": "#/$defs/id"}, "quantity": {"$ref": "#/$defs/optionalNonnegative"},
        "fill_at": {"$ref": "#/$defs/optionalUtc"}, "accounting_day": {"type": ["string", "null"], "format": "date"},
        "exit_price": {"$ref": "#/$defs/optionalDecimal"}, "price_verified": {"type": "boolean"},
        "gross_pnl": {"$ref": "#/$defs/optionalDecimal"}, "fees": {"$ref": "#/$defs/optionalNonnegative"},
        "fees_estimated": {"type": ["boolean", "null"]}, "net_pnl": {"$ref": "#/$defs/optionalDecimal"}
      },
      "allOf": [
        {"if": {"properties": {"price_verified": {"const": false}}}, "then": {"properties": {"exit_price": {"type": "null"}, "gross_pnl": {"type": "null"}, "net_pnl": {"type": "null"}}}},
        {"if": {"properties": {"price_verified": {"const": true}}}, "then": {"properties": {"exit_price": {"$ref": "#/$defs/nonnegativeDecimal"}}}}
      ]
    },
    "correction": {
      "type": "object", "additionalProperties": false,
      "required": ["correction_id", "execution_id", "activity_id", "exit_price", "fees", "reason"],
      "properties": {
        "correction_id": {"$ref": "#/$defs/id"}, "execution_id": {"$ref": "#/$defs/id"},
        "activity_id": {"$ref": "#/$defs/id"}, "exit_price": {"$ref": "#/$defs/nonnegativeDecimal"},
        "fees": {"$ref": "#/$defs/nonnegativeDecimal"}, "reason": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "daily": {
      "type": "object", "additionalProperties": false,
      "required": ["day", "recorded_equity", "realized_pnl", "includes_corrections"],
      "properties": {
        "day": {"type": "string", "format": "date"},
        "recorded_equity": {"$ref": "#/$defs/optionalDecimal"}, "realized_pnl": {"$ref": "#/$defs/optionalDecimal"},
        "includes_corrections": {"type": "boolean"}, "accounting_complete": {"type": "boolean"}
      }
    },
    "performance": {
      "type": "object", "additionalProperties": false,
      "required": ["currency", "daily", "exits", "corrections", "next_cursor"],
      "properties": {
        "currency": {"const": "USD"},
        "daily": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/daily"}},
        "exits": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/exit"}},
        "corrections": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/correction"}},
        "next_cursor": {"anyOf": [{"$ref": "#/$defs/cursor"}, {"type": "null"}]}
      }
    },
    "health": {
      "type": "object", "additionalProperties": false,
      "required": ["runtime", "last_monitor_completed_at", "persistence_fault", "accounting_unresolved", "daily_halted", "unmanaged_symbols", "activity_sync", "warnings"],
      "properties": {
        "runtime": {"enum": ["running", "stopped", "faulted", "unknown"]},
        "last_monitor_completed_at": {"$ref": "#/$defs/optionalUtc"},
        "persistence_fault": {"type": ["boolean", "null"]},
        "accounting_unresolved": {"type": ["boolean", "null"]}, "daily_halted": {"type": ["boolean", "null"]},
        "unmanaged_symbols": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "activity_sync": {
          "type": "object", "additionalProperties": false,
          "required": ["checkpoint_at", "status", "coverage"],
          "properties": {
            "checkpoint_at": {"$ref": "#/$defs/optionalUtc"},
            "status": {"enum": ["last_observed_complete", "incomplete", "unknown"]},
            "coverage": {"const": "bounded_overlap_not_full_history"}
          }
        },
        "warnings": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "task_failures": {"type": "object", "maxProperties": 32, "additionalProperties": {"type": "integer", "minimum": 1}}
      },
      "allOf": [
        {"if": {"properties": {"runtime": {"const": "running"}}}, "then": {"properties": {"last_monitor_completed_at": {"$ref": "#/$defs/utc"}, "persistence_fault": {"const": false}}}},
        {"if": {"properties": {"runtime": {"const": "faulted"}}}, "then": {"properties": {"persistence_fault": {"const": true}}}}
      ]
    },
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"enum": ["ledger_missing", "ledger_invalid", "schema_unsupported", "source_unavailable", "invalid_request", "snapshot_changed"]},
        "message": {"type": "string", "minLength": 1, "maxLength": 200}, "retryable": {"type": "boolean"}
      }
    }
  }
}