{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local investment setup responses",
  "oneOf": [
    {
      "type": "object",
      "required": ["enabled", "csrf", "state", "workspace"],
      "properties": {
        "enabled": {"type": "boolean"},
        "csrf": {"type": ["string", "null"], "maxLength": 256},
        "state": {"enum": ["empty", "ready", "manual_unopened", "blocked", "recoverable"]},
        "workspace": {"type": "string", "maxLength": 32768},
        "message": {"type": "string", "maxLength": 2000},
        "recovery": {
          "type": "object",
          "required": ["can_preview", "requires_opening", "profile", "opening_id"],
          "properties": {
            "can_preview": {"type": "boolean"},
            "requires_opening": {"type": "boolean"},
            "profile": {"type": "object"},
            "opening_id": {"type": "string", "minLength": 1, "maxLength": 200}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["preview_id", "expires_at", "profile", "opening", "report"],
      "properties": {
        "preview_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "expires_at": {"type": "string", "format": "date-time"},
        "profile": {
          "type": "object",
          "required": ["schema_version", "portfolio_id", "currency", "created_at", "accounts", "products", "policy"],
          "properties": {
            "schema_version": {"const": 2},
            "portfolio_id": {"type": "string", "minLength": 1, "maxLength": 200},
            "currency": {"const": "GBP"},
            "created_at": {"type": "string", "format": "date-time"},
            "accounts": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"type": "object"}},
            "products": {"type": "array", "maxItems": 100, "items": {"type": "object"}},
            "policy": {"type": "null"}
          },
          "additionalProperties": false
        },
        "opening": {
          "type": "object",
          "required": ["id", "type", "timestamp", "available_at", "evidence", "balances_gbp", "holdings"],
          "properties": {
            "id": {"type": "string", "minLength": 1, "maxLength": 200},
            "type": {"const": "opening"},
            "timestamp": {"type": "string", "format": "date-time"},
            "available_at": {"type": "string", "format": "date-time"},
            "evidence": {"type": "string", "minLength": 1, "maxLength": 200},
            "balances_gbp": {"type": "object", "additionalProperties": {"type": "string"}},
            "holdings": {"type": "array", "maxItems": 5000, "items": {"type": "object"}}
          },
          "additionalProperties": false
        },
        "report": {
          "type": "object",
          "required": ["schema_version", "equity_gbp", "complete"],
          "properties": {
            "schema_version": {"const": 2},
            "equity_gbp": {"type": ["string", "null"], "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
            "complete": {"type": "boolean"}
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["status", "revision"],
      "properties": {
        "status": {"enum": ["completed", "partial"]},
        "committed": {"type": "boolean"},
        "revision": {"type": ["integer", "null"], "minimum": 0},
        "receipt": {"type": ["object", "null"]},
        "message": {"type": "string", "maxLength": 2000}
      },
      "additionalProperties": false,
      "if": {"properties": {"status": {"const": "completed"}}},
      "then": {"properties": {"revision": {"type": "integer", "minimum": 1}, "committed": {"const": true}}}
    }
  ]
}
