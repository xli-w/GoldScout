{
  "name": "goldscout-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-validator.mjs",
    "dev": "npm run generate && vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "npm run generate && tsc --noEmit && vite build && node scripts/package-frontend.mjs",
    "test": "npm run test:browser",
    "test:browser": "playwright test",
    "test:unit": "node --test \"tests/*.test.mjs\" \"scripts/*.test.mjs\""
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.2.5",
    "@fontsource/ibm-plex-sans": "5.2.5",
    "@tanstack/react-query": "5.80.7",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "decimal.js": "10.5.0",
    "lucide-react": "0.511.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.1",
    "typescript": "5.8.3",
    "vite": "6.4.6"
  }
}