{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trader:market-intelligence:v1",
  "title": "Market Intelligence Contracts",
  "oneOf": [
    {"$ref": "#/$defs/settings"},
    {"$ref": "#/$defs/calendar_snapshot"},
    {"$ref": "#/$defs/news_evidence"},
    {"$ref": "#/$defs/ai_brief"},
    {"$ref": "#/$defs/control_request"},
    {"$ref": "#/$defs/control_receipt"},
    {"$ref": "#/$defs/news_observation"}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$", "not": {"pattern": "[^A-Za-z0-9_.:-]"}},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$", "maxLength": 32},
    "nullable_timestamp": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
    "revision": {"type": "integer", "minimum": 0},
    "nullable_revision": {"oneOf": [{"$ref": "#/$defs/revision"}, {"type": "null"}]},
    "url": {"type": "string", "format": "uri", "pattern": "^https://(?:[A-Za-z0-9.-]+|\\[[A-Fa-f0-9:]+\\])(?::443)?(?:[/?#][^\\s]*)?$", "not": {"pattern": "\\s"}, "maxLength": 2048},
    "symbol": {"enum": ["SPY", "QQQ", "BTC/USD", "GLD", "USO"]},
    "symbols": {"type": "array", "items": {"$ref": "#/$defs/symbol"}, "uniqueItems": true, "minItems": 1, "maxItems": 5},
    "category": {"enum": ["monetary_policy", "inflation", "employment", "growth", "energy"]},
    "settings": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "calendar_enabled", "news_enabled", "ai_enabled", "mode", "ai_profile", "revision"],
      "properties": {
        "enabled": {"type": "boolean"}, "calendar_enabled": {"type": "boolean"},
        "news_enabled": {"type": "boolean"}, "ai_enabled": {"type": "boolean"},
        "mode": {"enum": ["advisory", "shadow"]},
        "ai_profile": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "revision": {"$ref": "#/$defs/revision"}
      },
      "if": {"properties": {"ai_enabled": {"const": true}}, "required": ["ai_enabled"]},
      "then": {"properties": {"ai_profile": {"$ref": "#/$defs/id"}}}
    },
    "source_coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "categories", "checked_at", "coverage_start", "coverage_end", "status"],
      "properties": {
        "source": {"$ref": "#/$defs/id"},
        "categories": {"type": "array", "items": {"$ref": "#/$defs/category"}, "minItems": 1, "maxItems": 5, "uniqueItems": true},
        "checked_at": {"$ref": "#/$defs/nullable_timestamp"},
        "coverage_start": {"$ref": "#/$defs/nullable_timestamp"},
        "coverage_end": {"$ref": "#/$defs/nullable_timestamp"},
        "status": {"enum": ["healthy", "unavailable", "invalid"]},
        "input_hash": {"oneOf": [{"type": "string", "pattern": "^[a-f0-9]{64}$", "not": {"pattern": "[^a-f0-9]"}}, {"type": "null"}]},
        "source_url": {"oneOf": [{"$ref": "#/$defs/url"}, {"type": "null"}]}
      },
      "dependentRequired": {"input_hash": ["source_url"], "source_url": ["input_hash"]},
      "allOf": [
        {"if": {"properties": {"input_hash": {"type": "string"}}, "required": ["input_hash"]}, "then": {"properties": {"source_url": {"$ref": "#/$defs/url"}}}},
        {"if": {"properties": {"source_url": {"type": "string"}}, "required": ["source_url"]}, "then": {"properties": {"input_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}
      ],
      "if": {"properties": {"status": {"const": "healthy"}}, "required": ["status"]},
      "then": {"properties": {
        "checked_at": {"$ref": "#/$defs/timestamp"},
        "coverage_start": {"$ref": "#/$defs/timestamp"},
        "coverage_end": {"$ref": "#/$defs/timestamp"}
      }}
    },
    "calendar_event": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "source", "source_url", "category", "symbols", "scheduled_at", "available_at", "title", "status", "source_timezone", "published_at", "revision"],
      "properties": {
        "event_id": {"$ref": "#/$defs/id"}, "source": {"$ref": "#/$defs/id"},
        "source_url": {"$ref": "#/$defs/url"}, "category": {"$ref": "#/$defs/category"},
        "symbols": {"$ref": "#/$defs/symbols"}, "scheduled_at": {"$ref": "#/$defs/nullable_timestamp"},
        "available_at": {"$ref": "#/$defs/timestamp"},
        "title": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S"},
        "status": {"enum": ["scheduled", "tentative", "cancelled"]},
        "source_timezone": {"type": "string", "minLength": 1, "maxLength": 100},
        "published_at": {"$ref": "#/$defs/nullable_timestamp"}, "revision": {"$ref": "#/$defs/revision"}
      }
    },
    "calendar_snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "available_at", "sources", "events"],
      "properties": {
        "revision": {"$ref": "#/$defs/revision"}, "available_at": {"$ref": "#/$defs/timestamp"},
        "sources": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/source_coverage"}},
        "events": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/calendar_event"}}
      }
    },
    "news_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "source", "publisher_family", "source_url", "title", "snippet", "published_at", "received_at", "content_hash", "cluster_id", "supersedes"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/id"}, "source": {"$ref": "#/$defs/id"},
        "publisher_family": {"$ref": "#/$defs/id"}, "source_url": {"$ref": "#/$defs/url"},
        "title": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S", "not": {"pattern": "[\\u0000-\\u001f]"}},
        "snippet": {"type": "string", "maxLength": 2000, "not": {"pattern": "[\\u0000-\\u001f]"}},
        "published_at": {"$ref": "#/$defs/nullable_timestamp"}, "received_at": {"$ref": "#/$defs/timestamp"},
        "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$", "not": {"pattern": "[^a-f0-9]"}},
        "cluster_id": {"$ref": "#/$defs/id"},
        "supersedes": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
      }
    },
    "news_observation": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_id", "revision", "settings_revision", "started_at", "completed_at", "available_at", "status", "error_code", "acquisition_id", "last_success_id", "source"],
      "properties": {
        "attempt_id": {"$ref": "#/$defs/id"}, "revision": {"type": "integer", "minimum": 1},
        "settings_revision": {"$ref": "#/$defs/revision"},
        "started_at": {"$ref": "#/$defs/timestamp"}, "completed_at": {"$ref": "#/$defs/timestamp"},
        "available_at": {"$ref": "#/$defs/timestamp"}, "source": {"const": "fed_monetary"},
        "status": {"enum": ["successful", "unavailable", "invalid"]},
        "error_code": {"enum": [null, "endpoint_refused", "request_timeout", "request_in_progress", "address_refused", "http_unavailable", "encoding_refused", "content_refused", "response_too_large", "response_incomplete", "source_unavailable", "invalid_news", "parser_unavailable", "article_refused"]},
        "acquisition_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "last_success_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
      },
      "if": {"properties": {"status": {"const": "successful"}}, "required": ["status"]},
      "then": {"properties": {"error_code": {"type": "null"}, "acquisition_id": {"$ref": "#/$defs/id"}, "last_success_id": {"$ref": "#/$defs/id"}}},
      "else": {"properties": {"error_code": {"type": "string"}, "acquisition_id": {"type": "null"}}}
    },
    "claim": {
      "type": "object", "additionalProperties": false, "required": ["text", "evidence_ids"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 1000},
        "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "ai_brief": {
      "type": "object", "additionalProperties": false,
      "required": ["brief_id", "cluster_id", "claims", "interpretation", "uncertainties", "symbols", "recommendation", "verification", "available_at", "expires_at", "provider", "model", "prompt_version", "schema_version", "settings_revision", "input_hash", "tokens_used"],
      "properties": {
        "brief_id": {"$ref": "#/$defs/id"}, "cluster_id": {"$ref": "#/$defs/id"},
        "claims": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"$ref": "#/$defs/claim"}},
        "interpretation": {"type": "string", "minLength": 1, "maxLength": 2000},
        "uncertainties": {"type": "array", "maxItems": 10, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "symbols": {"$ref": "#/$defs/symbols"}, "recommendation": {"enum": ["watch", "review", "wait"]},
        "verification": {"enum": ["confirmed", "developing", "unverified"]},
        "available_at": {"$ref": "#/$defs/timestamp"}, "expires_at": {"$ref": "#/$defs/timestamp"},
        "provider": {"$ref": "#/$defs/id"}, "model": {"type": "string", "minLength": 1, "maxLength": 128},
        "prompt_version": {"$ref": "#/$defs/id"}, "schema_version": {"const": "1"},
        "settings_revision": {"$ref": "#/$defs/revision"}, "input_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "tokens_used": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]}
        ,"reservation_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
      }
    },
    "control_request": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "database_id", "base_revision", "requested_at", "expires_at", "settings"],
      "properties": {
        "request_id": {"$ref": "#/$defs/id"}, "database_id": {"$ref": "#/$defs/id"},
        "base_revision": {"$ref": "#/$defs/revision"}, "requested_at": {"$ref": "#/$defs/timestamp"},
        "expires_at": {"$ref": "#/$defs/timestamp"}, "settings": {"$ref": "#/$defs/settings"}
      }
    },
    "control_receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "database_id", "status", "effective_revision", "applied_at", "reason"],
      "properties": {
        "request_id": {"$ref": "#/$defs/id"}, "database_id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["pending", "applied", "rejected", "expired"]},
        "effective_revision": {"$ref": "#/$defs/nullable_revision"}, "applied_at": {"$ref": "#/$defs/nullable_timestamp"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500}
      },
      "if": {"properties": {"status": {"const": "applied"}}, "required": ["status"]},
      "then": {"properties": {"effective_revision": {"$ref": "#/$defs/revision"}, "applied_at": {"$ref": "#/$defs/timestamp"}}},
      "else": {"properties": {"applied_at": {"type": "null"}}}
    }
  }
}