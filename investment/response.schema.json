{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline investment snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_mode", "portfolio_id", "revision", "generated_at", "as_of", "currency", "complete", "equity_gbp", "net_contributions_gbp", "gain_gbp", "twr_pct", "max_drawdown_pct", "accounts", "holdings", "allocation", "proposal", "warnings", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "source_mode": {"enum": ["recorded", "demo"]},
    "portfolio_id": {"$ref": "#/$defs/text"},
    "revision": {"type": "integer", "minimum": 0, "maximum": 10000},
    "generated_at": {"$ref": "#/$defs/utc"},
    "as_of": {"anyOf": [{"$ref": "#/$defs/utc"}, {"type": "null"}]},
    "currency": {"const": "GBP"},
    "complete": {"type": "boolean"},
    "equity_gbp": {"$ref": "#/$defs/nullableDecimal"},
    "net_contributions_gbp": {"$ref": "#/$defs/decimal"},
    "gain_gbp": {"$ref": "#/$defs/nullableDecimal"},
    "twr_pct": {"$ref": "#/$defs/nullableDecimal"},
    "max_drawdown_pct": {"$ref": "#/$defs/nullableDecimal"},
    "accounts": {
      "type": "array", "minItems": 1, "maxItems": 50,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "kind", "cash_gbp"],
        "properties": {
          "id": {"$ref": "#/$defs/text"}, "name": {"$ref": "#/$defs/text"},
          "kind": {"enum": ["broker", "deposit"]},
          "cash_gbp": {"$ref": "#/$defs/nonnegativeDecimal"}
        }
      }
    },
    "holdings": {
      "type": "array", "maxItems": 5000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["account_id", "product_id", "name", "sleeve", "quantity", "value_gbp"],
        "properties": {
          "account_id": {"$ref": "#/$defs/text"}, "product_id": {"$ref": "#/$defs/text"},
          "name": {"$ref": "#/$defs/text"}, "sleeve": {"enum": ["equity", "bond"]},
          "quantity": {"$ref": "#/$defs/nonnegativeDecimal"},
          "value_gbp": {"$ref": "#/$defs/nullableDecimal"}
        }
      }
    },
    "allocation": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sleeve", "target_pct", "actual_pct", "drift_pp"],
        "properties": {
          "sleeve": {"enum": ["equity", "bond", "cash"]},
          "target_pct": {"$ref": "#/$defs/nonnegativeDecimal"},
          "actual_pct": {"$ref": "#/$defs/nullableDecimal"},
          "drift_pp": {"$ref": "#/$defs/nullableDecimal"}
        }
      }
    },
    "proposal": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reason", "expires_at", "orders", "manual_transfers", "execution_enabled"],
      "properties": {
        "status": {"enum": ["review", "no_trade", "blocked"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1000},
        "expires_at": {"anyOf": [{"$ref": "#/$defs/utc"}, {"type": "null"}]},
        "orders": {
          "type": "array", "maxItems": 5000,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["account_id", "product_id", "side", "quantity", "estimated_notional_gbp"],
            "properties": {
              "account_id": {"$ref": "#/$defs/text"}, "product_id": {"$ref": "#/$defs/text"},
              "side": {"enum": ["buy", "sell"]},
              "quantity": {"$ref": "#/$defs/nonnegativeDecimal"},
              "estimated_notional_gbp": {"$ref": "#/$defs/nonnegativeDecimal"}
            }
          }
        },
        "manual_transfers": {"$ref": "#/$defs/messages"},
        "execution_enabled": {"const": false}
      }
    },
    "warnings": {"$ref": "#/$defs/messages"},
    "limitations": {"$ref": "#/$defs/messages"}
  },
  "allOf": [
    {
      "if": {"properties": {"complete": {"const": true}}},
      "then": {"properties": {"equity_gbp": {"$ref": "#/$defs/nonnegativeDecimal"}, "gain_gbp": {"$ref": "#/$defs/decimal"}, "as_of": {"$ref": "#/$defs/utc"}}},
      "else": {"properties": {"equity_gbp": {"type": "null"}, "gain_gbp": {"type": "null"}, "twr_pct": {"type": "null"}, "max_drawdown_pct": {"type": "null"}}}
    },
    {
      "if": {"properties": {"proposal": {"properties": {"status": {"const": "blocked"}}}}},
      "then": {"properties": {"proposal": {"properties": {"orders": {"maxItems": 0}, "expires_at": {"type": "null"}}}}}
    }
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 200},
    "decimal": {"type": "string", "maxLength": 240, "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "nonnegativeDecimal": {"type": "string", "maxLength": 240, "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "nullableDecimal": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
    "utc": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$", "maxLength": 27},
    "messages": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 2000}}
  }
}
