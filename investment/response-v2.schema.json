{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline investment opening snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_mode", "portfolio_id", "revision", "generated_at", "as_of", "baseline_as_of", "currency", "complete", "equity_gbp", "net_contributions_gbp", "since_baseline_gain_gbp", "lifetime_gain_gbp", "recorded_fees_gbp", "recorded_interest_gbp", "recorded_dividends_gbp", "recorded_income_gbp", "recorded_fee_events", "recorded_account_fees", "recorded_income_events", "recorded_flow_events", "recorded_corrections", "recorded_profile_changes", "recorded_scope_additions_gbp", "recorded_scope_additions", "twr_pct", "max_drawdown_pct", "accounts", "cash_observations", "valuation_history", "holdings", "role_accounting", "role_accounting_at", "role_assignments", "proposal", "warnings", "limitations"],
  "properties": {
    "schema_version": {"const": 2},
    "source_mode": {"enum": ["recorded", "demo"]},
    "portfolio_id": {"$ref": "#/$defs/text"},
    "revision": {"type": "integer", "minimum": 0, "maximum": 10000},
    "generated_at": {"$ref": "#/$defs/utc"},
    "as_of": {"$ref": "#/$defs/nullableUtc"},
    "baseline_as_of": {"$ref": "#/$defs/nullableUtc"},
    "currency": {"const": "GBP"},
    "complete": {"type": "boolean"},
    "equity_gbp": {"$ref": "#/$defs/nullableDecimal"},
    "net_contributions_gbp": {"$ref": "#/$defs/decimal"},
    "since_baseline_gain_gbp": {"$ref": "#/$defs/nullableDecimal"},
    "lifetime_gain_gbp": {"type": "null"},
    "recorded_fees_gbp": {"$ref": "#/$defs/nonnegativeDecimal"},
    "recorded_interest_gbp": {"$ref": "#/$defs/nonnegativeDecimal"},
    "recorded_dividends_gbp": {"$ref": "#/$defs/nonnegativeDecimal"},
    "recorded_income_gbp": {"$ref": "#/$defs/nonnegativeDecimal"},
    "recorded_fee_events": {
      "type": "array", "maxItems": 10000,
      "items": {"$ref": "#/$defs/recordedFeeEvent"}
    },
    "recorded_account_fees": {
      "type": "array", "maxItems": 10000,
      "items": {"$ref": "#/$defs/recordedAccountFee"}
    },
    "recorded_income_events": {
      "type": "array", "maxItems": 10000,
      "items": {"$ref": "#/$defs/recordedIncomeEvent"}
    },
    "recorded_flow_events": {
      "type": "array", "maxItems": 10000,
      "items": {"$ref": "#/$defs/recordedFlowEvent"}
    },
    "recorded_corrections": {
      "type": "array", "maxItems": 10000,
      "items": {"$ref": "#/$defs/recordedCorrection"}
    },
    "recorded_profile_changes": {
      "type": "array", "maxItems": 10000,
      "items": {"$ref": "#/$defs/recordedProfileChange"}
    },
    "recorded_scope_additions_gbp": {"$ref": "#/$defs/nonnegativeDecimal"},
    "recorded_scope_additions": {
      "type": "array", "maxItems": 10000,
      "items": {"$ref": "#/$defs/recordedScopeAddition"}
    },
    "twr_pct": {"$ref": "#/$defs/nullableDecimal"},
    "max_drawdown_pct": {"$ref": "#/$defs/nullableDecimal"},
    "accounts": {
      "type": "array", "minItems": 1, "maxItems": 50,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "kind", "status", "cash_gbp", "terms", "cash_observation"],
        "properties": {
          "id": {"$ref": "#/$defs/text"}, "name": {"$ref": "#/$defs/text"},
          "kind": {"enum": ["broker", "deposit"]},
          "status": {"enum": ["active", "retired"]},
          "cash_gbp": {"anyOf": [{"$ref": "#/$defs/nonnegativeDecimal"}, {"type": "null"}]},
          "terms": {"anyOf": [{"$ref": "#/$defs/accountTerms"}, {"type": "null"}]},
          "cash_observation": {"anyOf": [{"$ref": "#/$defs/cashObservation"}, {"type": "null"}]}
        }
      }
    },
    "cash_observations": {
      "type": "array", "maxItems": 10000,
      "items": {"$ref": "#/$defs/cashObservationRecord"}
    },
    "valuation_history": {
      "type": "array", "maxItems": 10000,
      "items": {"$ref": "#/$defs/valuationHistoryPoint"}
    },
    "holdings": {
      "type": "array", "maxItems": 5000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["account_id", "product_id", "name", "sleeve", "quantity", "value_gbp", "mark_at", "mark_available_at"],
        "properties": {
          "account_id": {"$ref": "#/$defs/text"}, "product_id": {"$ref": "#/$defs/text"},
          "name": {"$ref": "#/$defs/text"}, "sleeve": {"enum": ["equity", "bond"]},
          "quantity": {"$ref": "#/$defs/nonnegativeDecimal"},
          "value_gbp": {"$ref": "#/$defs/nullableDecimal"},
          "mark_at": {"$ref": "#/$defs/nullableUtc"},
          "mark_available_at": {"$ref": "#/$defs/nullableUtc"}
        }
      }
    },
    "role_accounting": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "cash_gbp", "value_gbp", "accounts", "holdings"],
        "properties": {
          "role": {"enum": ["core", "dynamic", "unassigned"]},
          "cash_gbp": {"$ref": "#/$defs/nullableDecimal"},
          "value_gbp": {"$ref": "#/$defs/nullableDecimal"},
          "accounts": {"type": "array", "maxItems": 50, "items": {
            "type": "object", "additionalProperties": false,
            "required": ["account_id", "cash_gbp"],
            "properties": {"account_id": {"$ref": "#/$defs/text"}, "cash_gbp": {"$ref": "#/$defs/nonnegativeDecimal"}}
          }},
          "holdings": {"type": "array", "maxItems": 5000, "items": {
            "type": "object", "additionalProperties": false,
            "required": ["account_id", "product_id", "quantity"],
            "properties": {"account_id": {"$ref": "#/$defs/text"}, "product_id": {"$ref": "#/$defs/text"}, "quantity": {"$ref": "#/$defs/nonnegativeDecimal"}}
          }}
        }
      }
    },
    "role_accounting_at": {"$ref": "#/$defs/nullableUtc"},
    "role_assignments": {"type": "array", "maxItems": 10000, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "account_id", "product_id", "role", "amount", "timestamp", "available_at", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "account_id": {"$ref": "#/$defs/text"},
        "product_id": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
        "role": {"enum": ["core", "dynamic"]}, "amount": {"$ref": "#/$defs/nonnegativeDecimal"},
        "timestamp": {"$ref": "#/$defs/utc"}, "available_at": {"$ref": "#/$defs/utc"},
        "evidence": {"$ref": "#/$defs/text"}
      }
    }},
    "proposal": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reason", "expires_at", "orders", "manual_transfers", "execution_enabled"],
      "properties": {
        "status": {"const": "blocked"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1000},
        "expires_at": {"type": "null"},
        "orders": {"type": "array", "maxItems": 0},
        "manual_transfers": {"type": "array", "maxItems": 0},
        "execution_enabled": {"const": false}
      }
    },
    "warnings": {"$ref": "#/$defs/messages"},
    "limitations": {"$ref": "#/$defs/messages"}
  },
  "allOf": [
    {
      "if": {"properties": {"complete": {"const": true}}},
      "then": {"properties": {"equity_gbp": {"$ref": "#/$defs/nonnegativeDecimal"}, "as_of": {"$ref": "#/$defs/utc"}}},
      "else": {"properties": {"equity_gbp": {"type": "null"}, "as_of": {"type": "null"}, "since_baseline_gain_gbp": {"type": "null"}, "twr_pct": {"type": "null"}, "max_drawdown_pct": {"type": "null"}}}
    },
    {
      "if": {"properties": {"baseline_as_of": {"type": "null"}}},
      "then": {"properties": {"since_baseline_gain_gbp": {"type": "null"}, "twr_pct": {"type": "null"}, "max_drawdown_pct": {"type": "null"}}}
    }
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 200},
    "accountTerms": {
      "type": "object", "additionalProperties": false,
      "required": ["annual_rate_pct", "rate_basis", "effective_from", "observed_at", "available_at", "source", "maturity_date", "notice_days"],
      "properties": {
        "annual_rate_pct": {"anyOf": [{"type": "string", "maxLength": 24, "pattern": "^(100(\\.0+)?|([1-9][0-9]?|0)(\\.[0-9]+)?)$"}, {"type": "null"}]},
        "rate_basis": {"anyOf": [{"enum": ["AER", "gross"]}, {"type": "null"}]},
        "effective_from": {"type": "string", "format": "date"},
        "observed_at": {"$ref": "#/$defs/utc"},
        "available_at": {"$ref": "#/$defs/utc"},
        "source": {"$ref": "#/$defs/text"},
        "maturity_date": {"anyOf": [{"type": "string", "format": "date"}, {"type": "null"}]},
        "notice_days": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 3650}, {"type": "null"}]}
      }
    },
    "cashObservation": {
      "type": "object", "additionalProperties": false,
      "required": ["balance_gbp", "difference_gbp", "timestamp", "available_at", "source", "evidence"],
      "properties": {
        "balance_gbp": {"$ref": "#/$defs/nonnegativeDecimal"},
        "difference_gbp": {"$ref": "#/$defs/decimal"},
        "timestamp": {"$ref": "#/$defs/utc"},
        "available_at": {"$ref": "#/$defs/utc"},
        "source": {"$ref": "#/$defs/text"},
        "evidence": {"$ref": "#/$defs/text"}
      }
    },
    "cashObservationRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["account_id", "balance_gbp", "difference_gbp", "timestamp", "available_at", "source", "evidence"],
      "properties": {
        "account_id": {"$ref": "#/$defs/text"},
        "balance_gbp": {"$ref": "#/$defs/nonnegativeDecimal"},
        "difference_gbp": {"$ref": "#/$defs/decimal"},
        "timestamp": {"$ref": "#/$defs/utc"},
        "available_at": {"$ref": "#/$defs/utc"},
        "source": {"$ref": "#/$defs/text"},
        "evidence": {"$ref": "#/$defs/text"}
      }
    },
    "recordedFeeEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "account_id", "product_id", "role", "quantity", "price_gbp", "fee_gbp", "timestamp", "available_at", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "type": {"enum": ["buy", "sell"]},
        "role": {"enum": ["core", "dynamic", "unassigned"]},
        "account_id": {"$ref": "#/$defs/text"},
        "product_id": {"$ref": "#/$defs/text"},
        "quantity": {"$ref": "#/$defs/nonnegativeDecimal"},
        "price_gbp": {"$ref": "#/$defs/nonnegativeDecimal"},
        "fee_gbp": {"$ref": "#/$defs/nonnegativeDecimal"},
        "timestamp": {"$ref": "#/$defs/utc"},
        "available_at": {"$ref": "#/$defs/utc"},
        "evidence": {"$ref": "#/$defs/text"}
      }
    },
    "recordedAccountFee": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "account_id", "role", "amount_gbp", "timestamp", "available_at", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "type": {"const": "account_fee"},
        "role": {"enum": ["core", "dynamic", "unassigned"]},
        "account_id": {"$ref": "#/$defs/text"},
        "amount_gbp": {"$ref": "#/$defs/nonnegativeDecimal"},
        "timestamp": {"$ref": "#/$defs/utc"},
        "available_at": {"$ref": "#/$defs/utc"},
        "evidence": {"$ref": "#/$defs/text"}
      }
    },
    "recordedIncomeEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "account_id", "product_id", "role", "role_evidence", "amount_gbp", "timestamp", "available_at", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "type": {"enum": ["interest", "dividend"]},
        "role": {"enum": ["core", "dynamic", "unassigned"]},
        "role_evidence": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
        "account_id": {"$ref": "#/$defs/text"},
        "product_id": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
        "amount_gbp": {"$ref": "#/$defs/nonnegativeDecimal"},
        "timestamp": {"$ref": "#/$defs/utc"},
        "available_at": {"$ref": "#/$defs/utc"},
        "evidence": {"$ref": "#/$defs/text"}
      }
    },
    "recordedFlowEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "account_id", "destination_account_id", "role", "amount_gbp", "timestamp", "available_at", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "type": {"enum": ["contribution", "withdrawal", "transfer"]},
        "role": {"enum": ["core", "dynamic", "unassigned"]},
        "account_id": {"$ref": "#/$defs/text"},
        "destination_account_id": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
        "amount_gbp": {"$ref": "#/$defs/nonnegativeDecimal"},
        "timestamp": {"$ref": "#/$defs/utc"},
        "available_at": {"$ref": "#/$defs/utc"},
        "evidence": {"$ref": "#/$defs/text"}
      },
      "allOf": [{
        "if": {"properties": {"type": {"const": "transfer"}}},
        "then": {"properties": {"destination_account_id": {"$ref": "#/$defs/text"}}},
        "else": {"properties": {"destination_account_id": {"type": "null"}}}
      }]
    },
    "recordedCorrection": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "original_event_id", "replacement_event_id", "replaced_type",
        "account_id", "role", "role_evidence", "original_amount_gbp", "replacement_amount_gbp", "timestamp",
        "available_at", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "original_event_id": {"$ref": "#/$defs/text"},
        "replacement_event_id": {"$ref": "#/$defs/text"},
        "replaced_type": {"enum": ["contribution", "withdrawal", "transfer", "interest", "dividend", "buy", "sell", "account_fee", "split", "mark"]},
        "role": {"enum": ["core", "dynamic", "unassigned"]},
        "role_evidence": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
        "account_id": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
        "original_amount_gbp": {"$ref": "#/$defs/nullableDecimal"},
        "replacement_amount_gbp": {"$ref": "#/$defs/nullableDecimal"},
        "timestamp": {"$ref": "#/$defs/utc"},
        "available_at": {"$ref": "#/$defs/utc"},
        "evidence": {"$ref": "#/$defs/text"}
      }
    },
    "recordedProfileChange": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "action", "target", "entity_id", "name", "timestamp", "available_at", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "action": {"enum": ["add_product", "rename", "retire", "scope_addition"]},
        "target": {"enum": ["account", "product"]},
        "entity_id": {"$ref": "#/$defs/text"},
        "name": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
        "timestamp": {"$ref": "#/$defs/utc"},
        "available_at": {"$ref": "#/$defs/utc"},
        "evidence": {"$ref": "#/$defs/text"}
      }
    },
    "recordedScopeAddition": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "account_id", "amount_gbp", "timestamp", "available_at", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "account_id": {"$ref": "#/$defs/text"},
        "amount_gbp": {"$ref": "#/$defs/nonnegativeDecimal"},
        "timestamp": {"$ref": "#/$defs/utc"},
        "available_at": {"$ref": "#/$defs/utc"},
        "evidence": {"$ref": "#/$defs/text"}
      }
    },
    "valuationHistoryPoint": {
      "type": "object", "additionalProperties": false,
      "required": ["timestamp", "source_available_at", "as_of", "complete", "equity_gbp", "capital_basis_gbp", "net_contributions_gbp", "gain_since_baseline_gbp", "twr_pct", "max_drawdown_pct", "gap_reason"],
      "properties": {
        "timestamp": {"$ref": "#/$defs/utc"},
        "source_available_at": {"$ref": "#/$defs/utc"},
        "as_of": {"$ref": "#/$defs/nullableUtc"},
        "complete": {"type": "boolean"},
        "equity_gbp": {"$ref": "#/$defs/nullableDecimal"},
        "capital_basis_gbp": {"$ref": "#/$defs/nullableDecimal"},
        "net_contributions_gbp": {"$ref": "#/$defs/nullableDecimal"},
        "gain_since_baseline_gbp": {"$ref": "#/$defs/nullableDecimal"},
        "twr_pct": {"$ref": "#/$defs/nullableDecimal"},
        "max_drawdown_pct": {"$ref": "#/$defs/nullableDecimal"},
        "gap_reason": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"complete": {"const": true}}},
          "then": {
            "properties": {
              "as_of": {"$ref": "#/$defs/utc"},
              "equity_gbp": {"$ref": "#/$defs/nonnegativeDecimal"},
              "capital_basis_gbp": {"$ref": "#/$defs/decimal"},
              "net_contributions_gbp": {"$ref": "#/$defs/decimal"}
            },
            "oneOf": [
              {
                "properties": {
                  "gap_reason": {"type": "null"}
                }
              },
              {
                "properties": {
                  "gain_since_baseline_gbp": {"type": "null"},
                  "twr_pct": {"type": "null"},
                  "max_drawdown_pct": {"type": "null"},
                  "gap_reason": {
                    "const": "Historical correction invalidated performance evidence; no new baseline was established."
                  }
                }
              }
            ]
          },
          "else": {
            "properties": {
              "as_of": {"type": "null"},
              "equity_gbp": {"type": "null"},
              "capital_basis_gbp": {"type": "null"},
              "gain_since_baseline_gbp": {"type": "null"},
              "twr_pct": {"type": "null"},
              "max_drawdown_pct": {"type": "null"},
              "gap_reason": {"$ref": "#/$defs/text"}
            }
          }
        }
      ]
    },
    "decimal": {"type": "string", "maxLength": 240, "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "nonnegativeDecimal": {"type": "string", "maxLength": 240, "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "nullableDecimal": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
    "utc": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$", "maxLength": 27},
    "nullableUtc": {"anyOf": [{"$ref": "#/$defs/utc"}, {"type": "null"}]},
    "messages": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 2000}}
  }
}
