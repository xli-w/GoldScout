# Connection environment variable reference; not loaded automatically.
# Do not source or execute this reference: blank values can override settings.
# Keep this example blank. Configure real secrets privately in the process
# environment, never in this file, chat, source control, or command arguments.
#
# Optional shared HTTP proxy for public feeds, hosted AI, and eToro.
# Authenticated proxies must support HTTP Basic authentication; percent-encode
# reserved characters in the username and password. Basic credentials are sent
# to the HTTP proxy without transport encryption; use only a trusted network.
# An explicitly empty value disables proxy use. When unset, the application
# may consult the operator-managed dotenv configuration unless disabled below.
# A configured proxy has no direct-connection fallback.
TRADER_PROXY_URL=

# Optional: set to 1 to disable dotenv loading. Do not set this without first
# ensuring any required proxy is provided in the process environment.
PYTHON_DOTENV_DISABLED=

# Hosted AI: examples of operator-managed key names referenced by nonsecret
# provider profiles. The selected profile's key_env is authoritative and can
# name a different TRADER_AI_ variable. Local AI does not use a hosted key.
TRADER_AI_OPENAI_KEY=
TRADER_AI_ANTHROPIC_KEY=
TRADER_AI_GEMINI_KEY=

# eToro: both are read only by the separately approved monitoring collector.
# These placeholders do not establish eligibility, permission, or approval.
GOLDSCOUT_ETORO_API_KEY=
GOLDSCOUT_ETORO_USER_KEY=

# BLS, BEA, and Federal Reserve public feeds require no API-key variables.
# Model names, local ports, source selection, approval, and spending limits
# are not configured by these variables; see docs/intelligence.md and
# docs/monitoring.md for their respective controls and activation gates.
